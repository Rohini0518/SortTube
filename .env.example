# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string (Supabase pooler URL works well here).
DATABASE_URL=

# Google OAuth client, from Google Cloud Console (OAuth 2.0 Client IDs).
# Needs the youtube.readonly scope enabled on the consent screen, and the
# deployed app's /api/auth/callback/google URL added as an authorized
# redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js (next-auth v4) session secret — any long random string.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# The app's own canonical URL (used for OAuth callbacks).
# Local dev: http://localhost:3000
# Production: https://<your-vercel-app>.vercel.app
NEXTAUTH_URL=

# Plain API key (no OAuth) from Google Cloud Console, used for Guest Mode's
# read-only public channel/video lookups.
YOUTUBE_API_KEY=

# Video-summary generation: tries Gemini first, falls back to Groq if it
# fails or is rate-limited. Both are optional — summaries just won't
# generate if neither is set.
GEMINI_API_KEY=
GROQ_API_KEY=
